# Reviewable ISO 11783-10 Task Controller process-data/status payloads.
# Command codes are encoded in the low nibble of byte 0; the low four
# bits of the element number are encoded in byte 0 high nibble.

# B.8.1: byte 2 is the element number and bytes 3-4 the DDI, all "set to not
# available"; byte 5 is the TC/DL status bitfield; byte 8 is Reserved. This
# vector carried the TC number, version and channel count in those fields, and
# put the capability options in the status byte — so a TC-BAS announced "task
# totals active" from power-up with no task running.
tc_status_server_idle=FEFFFFFF000000FF
tech_capabilities_request=00FFFFFFFFFFFFFF
tech_capabilities_response_v4_b1_s8_c3=1004FF0000010803
malformed_tech_capabilities_request_bad_padding=0000FFFFFFFFFFFF
malformed_tech_capabilities_response_command_collision=1004FF0000010803
request_value_elem3_ddi1234=32003412FFFFFFFF
value_response_elem3_ddi1234_i32_99=3300341263000000
set_value_elem5_ddiCAFE_i32_305419896=5300FECA78563412
set_value_ack_elem5_ddiCAFE_i32_42=5A00FECA2A000000
ack_elem5_ddiCAFE_no_error=5D00FECA00FFFFFF
ack_elem5_ddiCAFE_value_outside_range=5D00FECA02FFFFFF
ack_elem5_ddiCAFE_no_resources=5D00FECA03FFFFFF
malformed_request_value_short=32003412
malformed_request_value_bad_padding=3200341200FFFFFF
malformed_request_value_overlong=32003412FFFFFFFF00
malformed_process_data_reserved_command=0BFFFFFFFFFFFFFF
malformed_set_value_ack_overlong=5A00FECA2A00000000
